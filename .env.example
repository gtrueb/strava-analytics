# Copy this file to .env and paste your own values.
# Get them at https://www.strava.com/settings/api  (create an app if you have none)
# In the Strava app settings set "Authorization Callback Domain" to exactly: localhost
#
# Keep .env private - it is git-ignored and should never be shared.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
